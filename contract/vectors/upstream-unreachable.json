{
  "description": "a transport failure is 502 upstream_unreachable",
  "request": {
    "method": "GET",
    "path": "/v1/preview",
    "query": "url=https%3A%2F%2Fa.example%2F"
  },
  "upstream": [
    {
      "url": "https://a.example/",
      "error": "unreachable"
    }
  ],
  "expect": {
    "status": 502,
    "headers": {
      "content-type": "application/json; charset=utf-8",
      "cache-control": "no-store"
    },
    "body": {
      "error": "upstream_unreachable",
      "message": "the target could not be reached"
    }
  }
}
