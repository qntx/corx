{
  "description": "a relative Location resolves against the current hop",
  "request": {
    "method": "GET",
    "path": "/v1/preview",
    "query": "url=https%3A%2F%2Fa.example%2F"
  },
  "upstream": [
    {
      "url": "https://a.example/",
      "accept": "text/html,application/xhtml+xml",
      "status": 302,
      "headers": {
        "location": "/b"
      }
    },
    {
      "url": "https://a.example/b",
      "status": 200,
      "headers": {
        "content-type": "text/html"
      },
      "body": "<html><head><title>B page</title></head><body>"
    }
  ],
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json; charset=utf-8",
      "cache-control": "public, max-age=86400, stale-while-revalidate=604800"
    },
    "body": {
      "kind": "page",
      "url": "https://a.example/",
      "finalUrl": "https://a.example/b",
      "source": "html",
      "fetchedAt": 1700000000,
      "title": "B page"
    }
  }
}
