{
  "description": "a 503 upstream response is 422 upstream_status",
  "request": {
    "method": "GET",
    "path": "/v1/preview",
    "query": "url=https%3A%2F%2Fa.example%2F"
  },
  "upstream": [
    {
      "url": "https://a.example/",
      "status": 503
    }
  ],
  "expect": {
    "status": 422,
    "headers": {
      "content-type": "application/json; charset=utf-8",
      "cache-control": "public, max-age=3600"
    },
    "body": {
      "error": "upstream_status",
      "message": "the upstream server returned an unexpected status",
      "upstreamStatus": 503
    }
  }
}
