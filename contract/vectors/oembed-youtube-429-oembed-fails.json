{
  "description": "a 429 from youtu.be keeps the upstream_status error when oEmbed fails",
  "request": {
    "method": "GET",
    "path": "/v1/preview",
    "query": "url=https%3A%2F%2Fyoutu.be%2FdQw4w9WgXcQ"
  },
  "upstream": [
    {
      "url": "https://youtu.be/dQw4w9WgXcQ",
      "status": 429
    },
    {
      "url": "https://www.youtube.com/oembed?url=https%3A%2F%2Fyoutu.be%2FdQw4w9WgXcQ&format=json",
      "accept": "application/json",
      "status": 401
    }
  ],
  "expect": {
    "status": 422,
    "headers": {
      "content-type": "application/json; charset=utf-8",
      "cache-control": "no-store"
    },
    "body": {
      "error": "upstream_status",
      "message": "the upstream server returned an unexpected status",
      "upstreamStatus": 429
    }
  }
}
