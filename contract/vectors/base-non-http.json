{
  "description": "a non-http base is ignored and URLs resolve against the page",
  "request": {
    "method": "GET",
    "path": "/v1/preview",
    "query": "url=https%3A%2F%2Fa.example%2Fdir%2Fpage.html"
  },
  "upstream": [
    {
      "url": "https://a.example/dir/page.html",
      "status": 200,
      "headers": {
        "content-type": "text/html"
      },
      "body": "<html><head><title>T</title><base href=\"ftp://x/y\"><meta property=\"og:image\" content=\"img.png\"></head><body>"
    }
  ],
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json; charset=utf-8",
      "cache-control": "public, max-age=86400, stale-while-revalidate=604800"
    },
    "body": {
      "kind": "page",
      "url": "https://a.example/dir/page.html",
      "finalUrl": "https://a.example/dir/page.html",
      "source": "html",
      "fetchedAt": 1700000000,
      "title": "T",
      "image": {
        "url": "https://a.example/dir/img.png"
      }
    }
  }
}
