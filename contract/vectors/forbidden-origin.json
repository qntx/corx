{
  "description": "a disallowed Origin is refused before any upstream fetch",
  "request": {
    "method": "GET",
    "path": "/v1/preview",
    "query": "url=https%3A%2F%2Fa.example%2F",
    "origin": "https://evil.example"
  },
  "expect": {
    "status": 403,
    "headers": {
      "content-type": "application/json; charset=utf-8",
      "cache-control": "no-store"
    },
    "body": {
      "error": "forbidden_origin",
      "message": "the request origin is not allowed"
    }
  }
}
