{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "corx preview response",
  "description": "The JSON body of GET|HEAD /v1/preview?url=… — one of page, media, or error.",
  "oneOf": [
    { "$ref": "#/$defs/page" },
    { "$ref": "#/$defs/media" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "finalUrl", "source", "fetchedAt"],
      "properties": {
        "kind": { "const": "page" },
        "url": { "type": "string", "format": "uri" },
        "finalUrl": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "description": { "type": "string", "minLength": 1, "maxLength": 600 },
        "siteName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "image": { "$ref": "#/$defs/image" },
        "favicon": { "type": "string", "minLength": 1, "format": "uri" },
        "card": { "type": "string", "minLength": 1, "maxLength": 50 },
        "type": { "type": "string", "minLength": 1, "maxLength": 50 },
        "themeColor": { "type": "string", "minLength": 1, "maxLength": 32 },
        "lang": { "type": "string", "minLength": 1, "maxLength": 35 },
        "source": { "enum": ["html", "oembed"] },
        "fetchedAt": { "type": "integer", "minimum": 0 }
      },
      "anyOf": [{ "required": ["title"] }, { "required": ["image"] }]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "minLength": 1, "format": "uri" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "alt": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "finalUrl", "mediaType", "fetchedAt"],
      "properties": {
        "kind": { "const": "media" },
        "url": { "type": "string", "format": "uri" },
        "finalUrl": { "type": "string", "format": "uri" },
        "mediaType": {
          "type": "string",
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
        },
        "size": { "type": "integer", "minimum": 0 },
        "fetchedAt": { "type": "integer", "minimum": 0 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "message"],
      "properties": {
        "error": {
          "enum": [
            "invalid_url",
            "forbidden_origin",
            "blocked_target",
            "not_found",
            "no_metadata",
            "method_not_allowed",
            "too_large",
            "unsupported_content",
            "redirect_failed",
            "upstream_status",
            "rate_limited",
            "upstream_unreachable",
            "overloaded",
            "upstream_timeout"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "upstreamStatus": { "type": "integer", "minimum": 100, "maximum": 599 }
      },
      "if": {
        "properties": { "error": { "const": "upstream_status" } }
      },
      "then": { "required": ["upstreamStatus"] },
      "else": { "not": { "required": ["upstreamStatus"] } }
    }
  }
}
